# Steam Web API key — get one free at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Your SteamID64 (a 17-digit number) — find it at https://steamid.io
STEAM_ID=

# IGDB (ratings, genres, tags) — free. Create an app in the Twitch developer
# console (https://dev.twitch.tv/console/apps, Client Type: Confidential), then
# copy its Client ID and generate a Client Secret. Step-by-step in the README.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# RAWG API key — OPTIONAL backup, only used when IGDB can't answer. RAWG is
# often down and is likely to be removed. Free at https://rawg.io/apidocs
RAWG_API_KEY=

# Server port (default 3001)
PORT=3001

# Address to bind (default 127.0.0.1). The API has no authentication, so only
# widen this to 0.0.0.0 on a network you trust.
HOST=127.0.0.1

# Set to 1 to seed the database with sample games (no API keys needed)
DEMO=
